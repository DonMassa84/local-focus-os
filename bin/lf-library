#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${LF_REPO:-$HOME/openclaw_training/open_source/local-focus-os}"
SYSTEM_LIB="$HOME/.local/share/local-focus-os/library"
PROJECT_LIB="$HOME/openclaw_training/system_library/local-focus-os"
REPORT_DIR="$HOME/.local/share/local-focus-os/reports"
LOG_DIR="$HOME/.local/share/local-focus-os/logs"

mkdir -p "$SYSTEM_LIB/docs" "$PROJECT_LIB/docs" "$REPORT_DIR" "$LOG_DIR"

cmd="${1:-status}"

refresh_library() {
  cd "$REPO"

  mkdir -p "$SYSTEM_LIB/docs" "$PROJECT_LIB/docs"

  for f in README.md README_DE.md ROADMAP.md PROJECT_STATUS.md SECURITY.md CONTRIBUTING.md LICENSE; do
    if [[ -f "$f" ]]; then
      cp -a "$f" "$SYSTEM_LIB/" 2>/dev/null || true
      cp -a "$f" "$PROJECT_LIB/" 2>/dev/null || true
    fi
  done

  cp -a docs/*.md "$SYSTEM_LIB/docs/" 2>/dev/null || true
  cp -a docs/*.md "$PROJECT_LIB/docs/" 2>/dev/null || true

  {
    echo "# Local Focus OS Systembibliothek"
    echo
    echo "## Pfade"
    echo
    echo "- Systembibliothek: $SYSTEM_LIB"
    echo "- Projektbibliothek: $PROJECT_LIB"
    echo "- Repo: $REPO"
    echo "- Reports: $REPORT_DIR"
    echo "- Logs: $LOG_DIR"
    echo
    echo "## Zentrale Register"
    echo
    echo "- docs/WORKFLOW_REGISTRY.md"
    echo "- docs/DOCUMENT_REGISTRY.md"
    echo "- docs/OPERATIONS_INDEX.md"
    echo
    echo "## Hauptdokumente"
    echo
    find "$SYSTEM_LIB" -maxdepth 1 -type f \( -name '*.md' -o -name 'LICENSE' \) -printf '- %f\n' | sort || true
    echo
    echo "## Dokumentation"
    echo
    find "$SYSTEM_LIB/docs" -maxdepth 1 -type f -name '*.md' -printf '- docs/%f\n' | sort || true
    echo
    echo "## Workflows"
    echo
    if [[ -d "$REPO/bin" ]]; then
      find "$REPO/bin" -maxdepth 1 -type f -name 'lf-*' -printf '- %f\n' | sort || true
    fi
    echo
    echo "## Betriebsbefehle"
    echo
    echo "\`\`\`bash"
    echo "lf-status"
    echo "lf-autonomy status"
    echo "lf-schedule status"
    echo "lf-schedule logs"
    echo "lf-inventory status"
    echo "lf-inventory refresh"
    echo "lf-library index"
    echo "lf-repro-check"
    echo "lf-secret-scan ."
    echo "lf-pdf-meta-scan ~/Downloads 10"
    echo "\`\`\`"
    echo
    echo "## Sicherheitsgrenzen"
    echo
    echo "- keine automatischen E-Mails"
    echo "- keine automatischen GitHub-Pushes"
    echo "- keine automatische Datei-Löschung"
    echo "- keine PDF-Veränderung"
    echo "- externe Aktionen nur nach Human Review"
  } > "$SYSTEM_LIB/INDEX.md"

  cp -a "$SYSTEM_LIB/INDEX.md" "$PROJECT_LIB/INDEX.md"
}

case "$cmd" in
  status)
    echo "==== LOCAL FOCUS OS SYSTEMBIBLIOTHEK ===="
    date
    echo
    echo "Systembibliothek: $SYSTEM_LIB"
    echo "Projektbibliothek: $PROJECT_LIB"
    echo "Repo: $REPO"
    echo
    echo "== Zentrale Register =="
    for f in WORKFLOW_REGISTRY.md DOCUMENT_REGISTRY.md OPERATIONS_INDEX.md; do
      if [[ -f "$SYSTEM_LIB/docs/$f" ]]; then
        echo "[OK] docs/$f"
      else
        echo "[FEHLT] docs/$f"
      fi
    done
    echo
    echo "== Dateien Systembibliothek =="
    find "$SYSTEM_LIB" -maxdepth 2 -type f | sort || true
    ;;

  refresh)
    refresh_library
    echo "[OK] Bibliothek aktualisiert"
    echo "Systembibliothek: $SYSTEM_LIB"
    echo "Projektbibliothek: $PROJECT_LIB"
    ;;

  index)
    refresh_library
    cat "$SYSTEM_LIB/INDEX.md"
    ;;

  open)
    refresh_library
    xdg-open "$SYSTEM_LIB" >/dev/null 2>&1 || echo "$SYSTEM_LIB"
    ;;

  reports)
    echo "Reports: $REPORT_DIR"
    find "$REPORT_DIR" -maxdepth 1 -type f | sort | tail -n 30 || true
    ;;

  logs)
    echo "Logs: $LOG_DIR"
    find "$LOG_DIR" -maxdepth 1 -type f | sort || true
    ;;

  *)
    cat << HELP
Usage:
  lf-library status
  lf-library refresh
  lf-library index
  lf-library open
  lf-library reports
  lf-library logs
HELP
    ;;
esac
