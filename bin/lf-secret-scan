#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${1:-$(pwd)}"

echo "==== SECRET SCAN ===="
echo "Root: $ROOT"
echo

SECRET_PATTERN='(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |OPENSSH |EC |DSA )?PRIVATE KEY-----|password[[:space:]]*=[[:space:]]*[^[:space:]]+|token[[:space:]]*=[[:space:]]*[^[:space:]]+|api_key[[:space:]]*=[[:space:]]*[^[:space:]]+)'

if grep -RInE \
  --exclude-dir='.git' \
  --exclude-dir='node_modules' \
  --exclude-dir='.cache' \
  --exclude='*.png' \
  --exclude='*.jpg' \
  --exclude='*.jpeg' \
  --exclude='*.pdf' \
  "$SECRET_PATTERN" "$ROOT" 2>/dev/null; then
  echo
  echo "[WARN] Potential secret found. Review manually before publishing."
  exit 2
else
  echo "[OK] No obvious secrets found."
fi
